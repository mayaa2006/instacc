# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Bearer token for the HTTP API / web dashboard (make up a long random string)
INSTACC_API_TOKEN=
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the agent (get yours from @userinfobot)
TELEGRAM_ALLOWED_USERS=
# Instagram (Facebook Login for Business: a System User token from Business Settings doesn't expire)
IG_USER_ID=
IG_ACCESS_TOKEN=
# TikTok developer app (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
